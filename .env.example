# Deployed backend (do not add a trailing slash — the API layer already
# builds paths as `${VITE_API_BASE_URL}/api/...`, a trailing slash here
# would produce a doubled `//`).
VITE_API_BASE_URL=https://luqyaapi.hlolk.com

# Must match a registered OpenIddict application on the backend.
# "Forge_App" is confirmed in OpenIddictDataSeedContributor.cs as the
# public SPA client (password + refresh_token grants, no secret).
VITE_ABP_APP_NAME=Forge_App
VITE_OAUTH_CLIENT_ID=Forge_App
VITE_OAUTH_SCOPE=Forge
