    <ProjectReference Include="../../modules/lostfound/src/LostFound.Application/LostFound.Application.csproj" />
    <ProjectReference Include="../../modules/lostfound/src/LostFound.HttpApi/LostFound.HttpApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Volo.Abp.Studio.Client.AspNetCore" Version="3.0.6" />
  </ItemGroup>
