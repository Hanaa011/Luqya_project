{
  "packages":[
    {
      "appRoutingModuleConfiguration":{
        "imports":[
          {
            "names":[
              "LOST_FOUND_ROUTES"
            ],
            "namespace": "@lost-found"
          } 
        ],
        "routes":[
          "{ path: 'lost-found', children: LOST_FOUND_ROUTES, canActivate: [authGuard] }"
        ]
      },
      "appModuleConfiguration":{
        "imports":[
          {
            "names":[
              "provideLostFound"
            ],
            "namespace": "@lost-found/config"
          }
        ],
        "providerNames":[
          "provideLostFound()"
        ]
      },
      "tsJsonPathRecordConfigurations":[
        {
          "name": "@lost-found",
          "paths": [
            "angular/projects/lost-found/src/public-api.ts"
          ]
        },
        {
          "name": "@lost-found/config",
          "paths": [
            "angular/projects/lost-found/config/src/public-api.ts"
          ]
        }
      ]
    }
  ]
}