<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>LostFound</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- PHASE-VALIDATION-08: data-driven lexicon files consumed by
         Importers.JsonLexiconDatasetImporter. Embedded (not copy-to-output
         content) so the vocabulary ships inside the DLL and is never
         missing at runtime regardless of working directory/deployment -
         see that class's remarks. Adding another lexicon file is a data
         change only: drop the .json file in this folder and list its
         resource name in JsonLexiconDatasetImporter.LexiconResourceNames. -->
    <EmbeddedResource Include="AI\Importers\Lexicon\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.GenAI" Version="1.13.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Volo.Abp.BlobStoring" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.Mapperly" Version="10.4.1" />
    <PackageReference Include="Volo.Abp.Ddd.Application" Version="10.4.1" />
    <ProjectReference Include="..\LostFound.Application.Contracts\LostFound.Application.Contracts.csproj" />
    <ProjectReference Include="..\LostFound.Domain\LostFound.Domain.csproj" />


		<PackageReference Include="Volo.Abp.PermissionManagement.Application" Version="10.4.1" />
		<PackageReference Include="Volo.Abp.FeatureManagement.Application" Version="10.4.1" />
		<PackageReference Include="Volo.Abp.SettingManagement.Application" Version="10.4.1" />
		<PackageReference Include="Volo.Abp.Account.Application" Version="10.4.1" />
		<PackageReference Include="Volo.Abp.Identity.Application" Version="10.4.1" />
		<PackageReference Include="Volo.Abp.TenantManagement.Application" Version="10.4.1" />
		<PackageReference Include="MiniExcel" Version="1.41.4" />
  </ItemGroup>

</Project>
