{
 "App": {
  "SelfUrl": "https://luqya-ai-api.hlolk.com",
  "AngularUrl": "https://luqya.hlolk.com",
  "CorsOrigins": "https://luqya.hlolk.com,http://localhost:5173",
  "RedirectAllowedUrls": "https://luqya.hlolk.com",
  "DisablePII": false,
  "HealthCheckUrl": "/health-status"
},
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=(LocalDb)\\MSSQLLocalDB;Database=Forge;Trusted_Connection=True;TrustServerCertificate=true"
  },
  "AuthServer": {
    "Authority": "https://luqyaapi.hlolk.com",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "Forge_Swagger",
    "CertificatePassPhrase": "8b28239b-5230-425b-81e8-43c683edb78b"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "0h1bjPjxigJnPbbB"
  },


  "LostFound": {
    "AI": {
      "Provider": "Gemini",
      "Gemini": {
        "ApiKey": "YOUR_GEMINI_API_KEY",
        "TextModel": "gemini-3.5-flash",
        "EmbeddingModel": "gemini-embedding-2"
      }
    }
  }



}